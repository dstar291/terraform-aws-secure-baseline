# Terraform working data and state: state can contain secrets, never commit it
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files hold real values. Commit only *.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example

# Lock file: ignored for the module itself (a module should work with any
# provider version in its allowed range) but NOT for examples/, where it is
# committed so provider hashes are reproducible.
/.terraform.lock.hcl

# Private working notes (kept local only)
TASKS.md

# Credentials and local config
.env
.env.*
!.env.example
*.pem
*.key
.aws/

# Generated test output
*.log

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
