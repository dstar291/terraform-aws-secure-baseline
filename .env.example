# Template only. Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never put real values in this file, it IS committed.

# GitHub identity used for commits in THIS repo only (not your employer's).
# Use your personal GitHub account. To avoid exposing your real address, use the
# noreply form from GitHub > Settings > Emails:  <id>+<username>@users.noreply.github.com
GIT_USER_NAME=
GIT_USER_EMAIL=

# GitHub personal access token. Prefer a fine-grained token limited to this one
# repository, with only the permissions you need (Contents: read/write,
# Pull requests: read/write), and a short expiry.
GITHUB_TOKEN=
